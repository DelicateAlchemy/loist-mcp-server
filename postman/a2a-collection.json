	"item": [
		{
			"name": "Agent Discovery",
			"item": [
				{
					"name": "GET /.well-known/agent-card.json",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Agent Card returned 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response is valid JSON\", function () {",
									"    pm.response.json();",
									"});",
									"",
									"pm.test(\"Agent Card has required fields\", function () {",
									"    const card = pm.response.json();",
									"    ",
									"    pm.expect(card.name).to.be.a('string').and.not.be.empty;",
									"    pm.expect(card.description).to.be.a('string').and.not.be.empty;",
									"    pm.expect(card.version).to.be.a('string');",
									"    pm.expect(card.protocolVersion).to.equal('0.3.0');",
									"    pm.expect(card.url).to.be.a('string').and.not.be.empty;",
									"    pm.expect(card.skills).to.be.an('array').and.have.length.of.at.least(1);",
									"});",
									"",
									"pm.test(\"Agent Card has expected skills\", function () {",
									"    const card = pm.response.json();",
									"    const skillIds = card.skills.map(skill => skill.id);",
									"    ",
									"    pm.expect(skillIds).to.include('process_audio_complete');",
									"    pm.expect(skillIds).to.include('search_library');",
									"    pm.expect(skillIds).to.include('get_audio_metadata');",
									"    pm.expect(skillIds).to.include('update_metadata');",
									"    pm.expect(skillIds).to.include('delete_audio');",
									"    pm.expect(skillIds).to.include('get_embed_url');",
									"});",
									"",
									"pm.test(\"Agent Card has valid capabilities\", function () {",
									"    const card = pm.response.json();",
									"    ",
									"    pm.expect(card.capabilities).to.be.an('object');",
									"    pm.expect(card.capabilities.streaming).to.be.a('boolean');",
									"    pm.expect(card.capabilities.pushNotifications).to.be.a('boolean');",
									"    pm.expect(card.capabilities.stateTransitionHistory).to.be.a('boolean');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/.well-known/agent-card.json",
							"host": [
								"{{base_url}}"
							],
							"path": [
								".well-known",
								"agent-card.json"
							]
						},
						"description": "Retrieve the A2A v0.3 Agent Card for agent discovery and capability information."
					},
					"response": []
				},

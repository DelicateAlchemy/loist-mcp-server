									"pm.test(\"Deprecated endpoint returns acceptable status\", function () {",
									"    const status = pm.response.code;",
									"    // Either 200 (supported) or 404 (not supported) is acceptable",
									"    pm.expect([200, 404]).to.contain(status);",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    pm.test(\"Deprecated endpoint returns valid JSON when supported\", function () {",
									"        pm.response.json();",
									"    });",
									"} else if (pm.response.code === 404) {",
									"    pm.test(\"Deprecated endpoint correctly returns 404 when not supported\", function () {",
									"        pm.expect(pm.response.code).to.equal(404);",
									"    });",
									"}"
								]
							}
						}
					],

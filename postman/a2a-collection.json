		{
			"name": "JSON-RPC Tasks",
			"item": [
				{
					"name": "POST / - message/send",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"message/send returned 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response is valid JSON\", function () {",
									"    pm.response.json();",
									"});",
									"",
									"pm.test(\"Response follows JSON-RPC 2.0\", function () {",
									"    const response = pm.response.json();",
									"    ",
									"    pm.expect(response.jsonrpc).to.equal('2.0');",
									"    pm.expect(response.id).to.exist;",
									"    pm.expect(response.result).to.exist;",
									"    pm.expect(response.error).to.be.undefined;",
									"});",
									"",
									"pm.test(\"Task object has required fields\", function () {",
									"    const response = pm.response.json();",
									"    const task = response.result;",
									"    ",
									"    pm.expect(task.id).to.be.a('string').and.not.be.empty;",
									"    pm.expect(task.status).to.be.an('object');",
									"    pm.expect(task.status.state).to.be.a('string');",
									"    pm.expect(['submitted', 'working', 'completed', 'failed']).to.include(task.status.state);",
									"    // Task may or may not have createdAt depending on A2A SDK serialization
    if (task.createdAt) {
        pm.expect(task.createdAt).to.be.a('string');
    }",
									"});",
									"",
									"pm.test(\"Task starts in submitted state\", function () {",
									"    const response = pm.response.json();",
									"    const task = response.result;",
									"    ",
									"    pm.expect(task.status.state).to.equal('submitted');",
									"});",
									"",
									"// Extract task_id for use in subsequent tasks/get requests",
									"const response = pm.response.json();",
									"if (response.result && response.result.id) {",
									"    pm.collectionVariables.set('task_id', response.result.id);",
									"    console.log('✅ Extracted task_id:', response.result.id);",
									"} else {",
									"    console.error('❌ Failed to extract task_id from response');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"{{$randomUUID}}\",\n  \"method\": \"message/send\",\n  \"params\": {\n    \"message\": {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"Process: {{audio_url}}\"\n        }\n      ]\n    }\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								""
							]
						},
						"description": "Create a new audio processing task via A2A message/send JSON-RPC method."
					},
					"response": []
				},
				{
					"name": "POST / - tasks/get",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"tasks/get returned 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response is valid JSON\", function () {",
									"    pm.response.json();",
									"});",
									"",
									"pm.test(\"Response follows JSON-RPC 2.0\", function () {",
									"    const response = pm.response.json();",
									"    ",
									"    pm.expect(response.jsonrpc).to.equal('2.0');",
									"    pm.expect(response.id).to.exist;",
									"    pm.expect(response.result).to.exist;",
									"    pm.expect(response.error).to.be.undefined;",
									"});",
									"",
									"pm.test(\"Task object has required fields\", function () {",
									"    const response = pm.response.json();",
									"    const task = response.result;",
									"    ",
									"    pm.expect(task.id).to.be.a('string').and.not.be.empty;",
									"    pm.expect(task.status).to.be.an('object');",
									"    pm.expect(task.status.state).to.be.a('string');",
									"    pm.expect(['submitted', 'working', 'completed', 'failed']).to.include(task.status.state);",
									"    // Task may or may not have createdAt depending on A2A SDK serialization
    if (task.createdAt) {
        pm.expect(task.createdAt).to.be.a('string');
    }",
									"});",
									"",
									"pm.test(\"Task shows state progression\", function () {",
									"    const response = pm.response.json();",
									"    const task = response.result;",
									"    const state = task.status.state;",
									"    ",
									"    // Task should have progressed from initial 'submitted' state",
									"    pm.expect(['working', 'completed', 'failed']).to.include(state);",
									"    console.log('✅ Task state:', state);",
									"});",
									"",
									"pm.test(\"Completed task has audio metadata\", function () {",
									"    const response = pm.response.json();",
									"    const task = response.result;",
									"    ",
									"    if (task.status.state === 'completed') {",
									"        pm.expect(task.metadata).to.be.an('object');",
									"        pm.expect(task.metadata.audio_track_id).to.be.a('string');",
									"        pm.expect(task.metadata.processing_result).to.be.an('object');",
									"        console.log('✅ Completed task has audio_track_id:', task.metadata.audio_track_id);",
									"    }",
									"});",
									"",
									"pm.test(\"Failed task has error information\", function () {",
									"    const response = pm.response.json();",
									"    const task = response.result;",
									"    ",
									"    if (task.status.state === 'failed') {",
									"        pm.expect(task.metadata).to.be.an('object');",
									"        pm.expect(task.metadata.error).to.be.an('object');",
									"        pm.expect(task.metadata.error.message).to.be.a('string');",
									"        console.log('✅ Failed task has error message:', task.metadata.error.message);",
									"    }",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"{{$randomUUID}}\",\n  \"method\": \"tasks/get\",\n  \"params\": {\n    \"id\": \"{{task_id}}\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								""
							]
						},
						"description": "Poll task status via A2A tasks/get JSON-RPC method using task_id from previous tasks/send response."
					},
					"response": []
				}
			],
			"description": "JSON-RPC task operations for A2A workflow (send task, get task status)"
		},
